---
const label = Astro.props.lang === 'uk' ? 'Повернутися нагору' : 'Go to top';
---
<a href="#page-top" class="back-to-top" data-back-to-top hidden aria-label={label} title={label}>
  <span class="back-to-top__icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 19V5m-6 6 6-6 6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
  <span class="back-to-top__label">{Astro.props.lang === 'uk' ? 'Нагору' : 'Go to top'}</span>
</a>
<script type="module" src="/scripts/ui/back-to-top.js?v=20261116-2"></script>
