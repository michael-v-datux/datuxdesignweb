---
/** Layout width + horizontal alignment (+ text alignment for text blocks). */
interface Props {
  showWidth?: boolean;
}

const { showWidth = true } = Astro.props;
---

{showWidth && (
  <div class="admin-form__field admin-form__field--inline">
    <div>
      <label class="admin-form__label">Width</label>
      <select name="layout" class="admin-input" required>
        <option value="1/1">1/1 (full column)</option>
        <option value="1/2">1/2</option>
        <option value="1/3">1/3</option>
        <option value="1/4">1/4</option>
        <option value="full">Full bleed</option>
      </select>
      <p class="admin-form__hint">How wide the block is within the row.</p>
    </div>
  </div>
)}

<div class="admin-form__field admin-form__field--inline">
  <div>
    <label class="admin-form__label">Position in row</label>
    <select name="align" class="admin-input">
      <option value="left" selected>Left</option>
      <option value="center">Center</option>
      <option value="right">Right</option>
    </select>
    <p class="admin-form__hint">Where the block sits horizontally.</p>
  </div>
</div>

<div class="admin-form__field hidden" data-field-text-align>
  <label class="admin-form__label">Text alignment</label>
  <select name="text_align" class="admin-input">
    <option value="left">Left</option>
    <option value="center">Center</option>
    <option value="right">Right</option>
    <option value="justify">Justify</option>
  </select>
</div>
