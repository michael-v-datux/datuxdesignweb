---
import { normalizeCaseTheme } from '../../../public/scripts/lib/case-design.js';
const value = normalizeCaseTheme(Astro.props.value);
---
<div class="admin-form__field">
  <label class="admin-form__label" for="case-theme">Case visual theme</label>
  <select class="admin-input" id="case-theme" name="case_theme">
    <option value="classic" selected={value === 'classic'}>Classic · geometric / editorial</option>
    <option value="fluid" selected={value === 'fluid'}>Fluid · waves / expressive typography</option>
    <option value="playful" selected={value === 'playful'}>Playful · mint / checkpoints / tickets</option>
    <option value="journal" selected={value === 'journal'}>Journal · teal / margin notes / paper frames</option>
    <option value="dialogue" selected={value === 'dialogue'}>Dialogue · dark / coral / conversation cards</option>
    <option value="system" selected={value === 'system'}>System · blue / specification / component specimens</option>
    <option value="workbench" selected={value === 'workbench'}>Workbench · graphite / cyan / product workflows</option>
    <option value="search" selected={value === 'search'}>Search · ivory / violet / query to decision</option>
    <option value="network" selected={value === 'network'}>Network · river blue / connected sites / archive</option>
  </select>
  <p class="admin-help">Sets the hero and visual language. Section compositions remain individually editable.</p>
</div>
