---
/** Visual options for image / media blocks. */
---

<div class="admin-form__field admin-form__field--inline" data-field-media-style>
  <div>
    <label class="admin-form__label">Corner radius</label>
    <select name="border_radius" class="admin-input">
      <option value="none">None</option>
      <option value="sm">Small</option>
      <option value="md" selected>Medium</option>
      <option value="lg">Large</option>
      <option value="xl">Extra large</option>
      <option value="full">Pill / circle</option>
      <option value="custom">Custom…</option>
    </select>
  </div>
  <div data-field-radius-custom class="hidden">
    <label class="admin-form__label">Custom radius</label>
    <input
      name="border_radius_custom"
      class="admin-input"
      placeholder="e.g. 24px or 1.5rem"
    />
  </div>
</div>

<div class="admin-form__field admin-form__field--inline" data-field-media-style>
  <div>
    <label class="admin-form__label">Frame proportions</label>
    <select name="aspect_ratio" class="admin-input">
      <option value="auto" selected>Original (no crop)</option>
      <option value="16/9">Landscape · 16:9</option>
      <option value="4/3">Landscape · 4:3</option>
      <option value="1/1">Square · 1:1</option>
      <option value="3/4">Portrait · 3:4</option>
      <option value="9/16">Portrait · 9:16</option>
    </select>
  </div>
  <div>
    <label class="admin-form__label">Image fit</label>
    <select name="object_fit" class="admin-input">
      <option value="cover" selected>Cover (fill frame)</option>
      <option value="contain">Contain (show full image)</option>
    </select>
  </div>
  <div>
    <label class="admin-form__label">Shadow</label>
    <select name="shadow" class="admin-input">
      <option value="none">None</option>
      <option value="sm">Light</option>
      <option value="md" selected>Medium</option>
      <option value="lg">Strong</option>
    </select>
  </div>
</div>

<div class="admin-form__field" data-field-media-style>
  <label class="admin-form__label">Presentation frame</label>
  <select name="frame" class="admin-input">
    <option value="none">None · original image</option>
    <option value="browser">Browser · desktop screen</option>
    <option value="canvas">Canvas · floating artwork</option>
  </select>
</div>
