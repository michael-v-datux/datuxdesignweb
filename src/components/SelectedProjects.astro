---
export const prerender = false;

import { supabase } from '@/lib/supabaseClient';
import {
  projectCardCategory,
  projectCardThumbnail,
  projectCardTitle,
} from '@/lib/projects/card-labels';
import ProjectCard from '@/components/ProjectCard.astro';

const { translations, lang, loadMore = true } = Astro.props;

const { data: projectsRaw, error } = await supabase
  .from("projects")
  .select("slug, title_en, title_uk, category_en, category_uk, thumbnail_url, cover_url, is_published")
  .eq("is_published", true)
  .order("created_at", { ascending: false })
  .range(0, 2);

if (error) {
  console.error("Error fetching projects:", error);
}

const projects =
  projectsRaw
    ?.map((p) => ({
      slug: p.slug,
      title: projectCardTitle(p),
      category: projectCardCategory(p),
      thumbnail: projectCardThumbnail(p),
    }))
    .filter((p) => p.title) || [];
---

<section id="selected-projects" class="selected-projects w-full py-12 px-6 md:px-10 lg:px-16">
  <div class="max-w-6xl mx-auto text-center">
    <h2 class="text-2xl md:text-3xl font-semibold mb-12">
      {translations.selectedProjects.title}
    </h2>

    {projects && projects.length > 0 ? (
      <div id="projects-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 justify-center">
        {projects.map((item) => (
          <ProjectCard
            slug={item.slug}
            title={item.title}
            category={item.category}
            thumbnail={item.thumbnail}
            lang={lang}
          />
        ))}
      </div>
    ) : (
      <p class="text-neutral-500">{lang === 'uk' ? 'Проекти наразі недоступні.' : 'No projects available.'}</p>
    )}

    {loadMore && (
      <button
        id="load-more"
        type="button"
        class="mt-8 px-6 py-2 border rounded-lg bg-neutral-100 hover:bg-neutral-200 transition"
        data-label-load-more={translations.selectedProjects.loadMore}
        data-label-loading={translations.selectedProjects.loading}
        data-label-error={translations.selectedProjects.loadError}
      >
        {translations.selectedProjects.loadMore}
      </button>
    )}
  </div>
</section>

{loadMore && <script type="module" src="/scripts/features/load-more-projects.js"></script>}
