---
const { translations } = Astro.props;
---

<section id="hello" class="hero w-full min-h-screen flex flex-col justify-center text-left py-24 px-6 md:px-10 lg:px-16">
  <div class="hero__visual max-[880px]:hidden" aria-hidden="true">
    <canvas class="hero__canvas"></canvas>
    <div
      class="hero__orb"
      role="button"
      tabindex="0"
      aria-label={translations.hero.orbEasterEgg.ariaLabel}
      aria-pressed="false"
    >
      <span class="hero__orb-flipper">
        <span class="hero__orb-face hero__orb-face--front">
          <span class="hero__orb-inner"></span>
        </span>
        <span class="hero__orb-face hero__orb-face--back">
          <span class="hero__orb-back-tag">{translations.hero.orbEasterEgg.tag}</span>
          <span class="hero__orb-back-line">{translations.hero.orbEasterEgg.line1}</span>
          <span class="hero__orb-back-line hero__orb-back-line--muted">{translations.hero.orbEasterEgg.line2}</span>
        </span>
      </span>
    </div>
  </div>

  <div class="hero__content w-full max-w-6xl mx-auto text-left">
    <h1 class="text-4xl md:text-5xl lg:text-7xl font-medium leading-tight">
      {translations.hero.titleLine1}<br />
      {translations.hero.titleLine2.before}
      <span class="text-pink-g italic font-medium">{translations.hero.titleLine2.purpose}</span>
      {translations.hero.titleLine2.and}
      <span class="text-sky-g italic font-medium">{translations.hero.titleLine2.precision}</span>
    </h1>
    <p class="mt-12 text-sm md:text-base text-neutral-600 dark:text-neutral-400">
      {translations.hero.subtitleLine1}<br />
      {translations.hero.subtitleLine2}
    </p>
  </div>
</section>

<script type="module" src="/scripts/features/hero-motion.js"></script>
