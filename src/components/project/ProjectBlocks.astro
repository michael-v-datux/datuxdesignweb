---
import ProjectRow from './ProjectRow.astro';
import { groupBlocksIntoRows } from '@/lib/projects/rows';
import type {
  ProjectBlock as ProjectBlockType,
  ProjectLayout,
} from '@/lib/projects/types';

interface Props {
  blocks?: ProjectBlockType[];
  layout?: ProjectLayout | null;
  lang: string;
}

const { blocks = [], layout, lang } = Astro.props;

function blocksForRow(
  row: ProjectLayout['rows'][number]
): ProjectBlockType[] {
  return row.columns.flatMap((col) =>
    col.blocks.map((block) => ({
      ...block,
      layout: col.span,
    }))
  );
}

const useExplicitLayout = Boolean(layout?.rows?.length);
const explicitRows = layout?.rows ?? [];
const packedRows = groupBlocksIntoRows(blocks);
---

<div class="project-blocks">
  {
    useExplicitLayout
      ? explicitRows.map((row) => (
          <ProjectRow blocks={blocksForRow(row)} lang={lang} />
        ))
      : packedRows.map((rowBlocks) => (
          <ProjectRow blocks={rowBlocks} lang={lang} />
        ))
  }
</div>
