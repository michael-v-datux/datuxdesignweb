---
import ProjectRow from './ProjectRow.astro';
import { groupBlocksIntoRows } from '@/lib/projects/rows';
import type { ProjectBlock as ProjectBlockType } from '@/lib/projects/types';

interface Props {
  blocks: ProjectBlockType[];
  lang: string;
}

const { blocks, lang } = Astro.props;
const rows = groupBlocksIntoRows(blocks);
---

<div class="project-blocks">
  {rows.map((rowBlocks) => (
    <ProjectRow blocks={rowBlocks} lang={lang} />
  ))}
</div>
