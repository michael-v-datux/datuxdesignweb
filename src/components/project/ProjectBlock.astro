---
import { blockAlign, blockText, blockTextAlign } from '@/lib/projects/blocks';
import ProjectMedia from './ProjectMedia.astro';
import type { ProjectBlock } from '@/lib/projects/types';

interface Props {
  block: ProjectBlock;
  lang: string;
}

const { block, lang } = Astro.props;
const layoutClass = `project-block--layout-${String(block.layout).replace('/', '-')}`;
const { content, type } = block;
const text = blockText(content, lang);
const alignClass = `project-block--align-${blockAlign(content)}`;
const textAlignClass =
  type === 'text' ? `project-block__text--align-${blockTextAlign(content)}` : '';
const textStyle = ['body', 'lead', 'callout'].includes(content.textStyle || '') ? content.textStyle : 'body';
---

<article
  class:list={['project-block', `project-block--${type}`, layoutClass, alignClass, type === 'text' && `project-block--text-${textStyle}`]}
  data-block-id={block.id}
  data-block-type={type}
>
  {type === 'text' && text && (
    <div class:list={['project-block__text', textAlignClass]}>
      {/<[a-z][\s\S]*>/i.test(text) ? (
        <div class="project-block__html text-lg leading-relaxed" set:html={text} />
      ) : (
        <p class="project-block__html whitespace-pre-wrap">{text}</p>
      )}
    </div>
  )}

  {type === 'text' && !text && (
    <p class="project-block__empty text-neutral-400 text-sm">—</p>
  )}

  {type !== 'text' && !content.url && (
    <div class="case-media-placeholder">{lang === 'uk' ? 'Додайте зображення в редакторі' : 'Add an image in the editor'}</div>
  )}
  {type !== 'text' && content.url && (
    <ProjectMedia {content} video={type === 'media' && content.mediaType === 'video'} {lang} />
  )}
</article>
