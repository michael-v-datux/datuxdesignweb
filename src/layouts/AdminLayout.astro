---
export const prerender = false;

interface Props {
  title?: string;
  hideNav?: boolean;
  activeNav?: "dashboard" | "gallery" | "new";
  wide?: boolean;
}

const { title = "Admin", hideNav = false, activeNav, wide = true } = Astro.props;
const bodyClass = hideNav ? "admin-body admin-body--login" : "admin-body";
const shellClass = wide ? "admin-shell admin-shell--wide" : "admin-shell";
const topnavInnerClass = wide ? "admin-topnav__inner admin-topnav__inner--wide" : "admin-topnav__inner";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Admin | datux.design</title>
    <link rel="stylesheet" href="/styles/main.css" />
  </head>

  <body class={bodyClass}>
    {!hideNav && (
      <header class="admin-topnav">
        <div class={topnavInnerClass}>
          <a href="/admin/dashboard" class="admin-topnav__logo">
            datux.design · Admin
          </a>

          <nav class="admin-topnav__nav">
            <a
              href="/en/"
              class="admin-topnav__link admin-topnav__link--site"
              target="_blank"
              rel="noopener noreferrer"
            >
              View site ↗
            </a>
            <a
              href="/admin/dashboard"
              class:list={[
                "admin-topnav__link",
                activeNav === "dashboard" && "is-active",
              ]}
            >
              Projects
            </a>
            <a
              href="/admin/gallery"
              class:list={[
                "admin-topnav__link",
                activeNav === "gallery" && "is-active",
              ]}
            >
              Gallery
            </a>
            <a
              href="/admin/projects/new"
              class:list={[
                "admin-topnav__link",
                activeNav === "new" && "is-active",
              ]}
            >
              New project
            </a>
            <button type="button" id="admin-logout" class="admin-topnav__logout">
              Logout
            </button>
          </nav>
        </div>
      </header>
    )}

    <main class={shellClass}>
      <slot />
    </main>

    {!hideNav && (
      <footer class="admin-footer">Admin Panel · datux.design</footer>
    )}

    {!hideNav && (
      <script>
        document.getElementById("admin-logout")?.addEventListener("click", async () => {
          await fetch("/api/admin-logout", {
            method: "POST",
            credentials: "same-origin",
          });
          window.location.href = "/admin";
        });
      </script>
    )}
  </body>
</html>
