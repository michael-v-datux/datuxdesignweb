---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminPageHeader from "../../components/admin/AdminPageHeader.astro";
export const prerender = false;
---

<AdminLayout title="Dashboard" activeNav="dashboard">
  <AdminPageHeader
    title="Projects"
    subtitle="Create, edit, and publish portfolio case studies."
  >
    <a slot="actions" href="/admin/projects/new" class="admin-btn admin-btn--primary">
      + New project
    </a>
  </AdminPageHeader>

  <div id="projects" class="admin-project-list"></div>

  <script type="module" src="/scripts/admin/dashboard.js"></script>
</AdminLayout>
