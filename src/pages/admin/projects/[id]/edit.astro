---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import supabase from "../../../../lib/supabaseClient";
import { normalizeBlock, blockText } from "../../../../lib/projects/blocks";

const { id } = Astro.params;

// Проект
const { data: project, error: projectError } = await supabase
  .from("projects")
  .select("*")
  .eq("id", id)
  .maybeSingle();

if (projectError) {
  console.error(projectError);
}

// Блоки
const { data: blocksRaw, error: blocksError } = await supabase
  .from("projects_blocks")
  .select("*")
  .eq("project_id", id)
  .order("position", { ascending: true });

const blocks = (blocksRaw ?? []).map((row) =>
  normalizeBlock(row as Record<string, unknown>)
);

if (blocksError) {
  console.error(blocksError);
}
---

<AdminLayout title={`Edit: ${project?.slug ?? "Project"}`} section="projects">
  <!-- SECTION 1: Project info form -->
  <section class="admin-table-card">
    <div class="admin-table-card__header">
      <h2>Project info</h2>
      <button
        class="admin-btn admin-btn--primary"
        type="button"
        data-project-save
      >
        Save changes
      </button>
    </div>

    <div class="p-4">
      <form class="admin-form" data-project-form>
        <div class="admin-form__field admin-form__field--inline">
          <div>
            <label class="admin-form__label">Slug</label>
            <input
              class="admin-input"
              name="slug"
              value={project?.slug ?? ""}
              placeholder="search-engine"
            />
          </div>
          <div>
            <label class="admin-form__label">Status</label>
            <select name="status" class="admin-input">
              <option
                value="draft"
                selected={project?.status === "draft" || !project?.status}
              >
                Draft
              </option>
              <option
                value="published"
                selected={project?.status === "published"}
              >
                Published
              </option>
            </select>
          </div>
        </div>

        <div class="admin-form__field admin-form__field--inline">
          <div>
            <label class="admin-form__label">Title (EN)</label>
            <input
              class="admin-input"
              name="title_en"
              value={project?.title_en ?? ""}
              placeholder="Search Engine"
            />
          </div>
          <div>
            <label class="admin-form__label">Title (UK)</label>
            <input
              class="admin-input"
              name="title_uk"
              value={project?.title_uk ?? ""}
              placeholder="Пошуковий проєкт"
            />
          </div>
        </div>

        <div class="admin-form__field admin-form__field--inline">
          <div>
            <label class="admin-form__label">Category (EN)</label>
            <input
              class="admin-input"
              name="category_en"
              value={project?.category_en ?? ""}
              placeholder="Search"
            />
          </div>
          <div>
            <label class="admin-form__label">Category (UK)</label>
            <input
              class="admin-input"
              name="category_uk"
              value={project?.category_uk ?? ""}
              placeholder="Пошук"
            />
          </div>
        </div>

        <div class="admin-form__field">
          <label class="admin-form__label">Description (EN)</label>
          <textarea
            class="admin-input"
            name="description_en"
            rows="3"
          >{project?.description_en ?? ""}</textarea>
        </div>

        <div class="admin-form__field">
          <label class="admin-form__label">Description (UK)</label>
          <textarea
            class="admin-input"
            name="description_uk"
            rows="3"
          >{project?.description_uk ?? ""}</textarea>
        </div>

        <div class="admin-form__field admin-form__field--inline">
          <div>
            <label class="admin-form__label">Thumbnail URL</label>
            <input
              class="admin-input"
              name="thumbnail_url"
              value={project?.thumbnail_url ?? ""}
              placeholder="https://..."
            />
          </div>
          <div>
            <label class="admin-form__label">Cover URL</label>
            <input
              class="admin-input"
              name="cover_url"
              value={project?.cover_url ?? ""}
              placeholder="https://..."
            />
          </div>
        </div>

        <div class="admin-form__field admin-form__field--inline">
          <div class="flex items-center gap-2">
            <input
              id="is_published"
              type="checkbox"
              name="is_published"
              checked={project?.is_published ?? false}
            />
            <label class="admin-form__label" for="is_published">
              Published
            </label>
          </div>

          <div class="flex items-center gap-2">
            <input
              id="is_protected"
              type="checkbox"
              name="is_protected"
              checked={project?.is_protected ?? false}
            />
            <label class="admin-form__label" for="is_protected">
              Password protected
            </label>
          </div>
        </div>

        <div class="admin-form__field">
          <label class="admin-form__label">Password hash</label>
          <input
            class="admin-input"
            name="password_hash"
            value={project?.password_hash ?? ""}
            placeholder="Optional (hash)"
          />
          <p class="admin-form__hint">
            Тут поки що очікується готовий hash. Пізніше можна буде додати
            окрему логіку для хешування.
          </p>
        </div>
      </form>
    </div>
  </section>

  <!-- SECTION 2: Blocks management -->
  <section class="admin-table-card">
    <div class="admin-table-card__header">
      <h2>Blocks</h2>
      <button
        class="admin-btn admin-btn--primary"
        type="button"
        data-admin-modal-open="add-block"
      >
        + Add block
      </button>
    </div>

    <table class="admin-table" data-blocks-table data-project-id={id}>
      <thead>
        <tr>
          <th>Pos</th>
          <th>Type</th>
          <th>Layout</th>
          <th>Preview</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {blocks?.map((b) => {
          const preview =
            b.type === "text"
              ? blockText(b.content, "en")
              : b.content?.url
                ? `Media: ${String(b.content.url).split("/").slice(-1)[0]}`
                : "";
          const short =
            preview.length > 60 ? preview.slice(0, 60) + "…" : preview;
          return (
          <tr data-block-id={b.id} draggable="true">
            <td>{b.position}</td>
            <td>{b.type}</td>
            <td>{b.layout}</td>
            <td>{short}</td>
            <td style="text-align:right;">
              <button
                type="button"
                class="admin-btn admin-btn--ghost"
                data-block-delete
              >
                Delete
              </button>
            </td>
          </tr>
          );
        })}
      </tbody>
    </table>
  </section>

  <!-- Modal: Add block -->
  <div class="admin-modal" data-admin-modal="add-block" aria-hidden="true">
    <div class="admin-modal__backdrop" data-admin-modal-close></div>
    <div class="admin-modal__dialog">
      <div class="admin-modal__header">
        <h3 class="admin-modal__title">Add block</h3>
        <button class="admin-modal__close" data-admin-modal-close>×</button>
      </div>

      <form class="admin-form" data-block-create-form>
        <div class="admin-form__field">
          <label class="admin-form__label">Type</label>
          <select name="type" class="admin-input" required>
            <option value="text">Text</option>
            <option value="image">Image</option>
            <option value="media">Media</option>
          </select>
        </div>

        <div class="admin-form__field">
          <label class="admin-form__label">Layout</label>
          <select name="layout" class="admin-input" required>
            <option value="1/1">1/1 (default)</option>
            <option value="1/2">1/2</option>
            <option value="1/3">1/3</option>
            <option value="1/4">1/4</option>
            <option value="full">Full width</option>
          </select>
        </div>

        <div class="admin-form__field" data-field-text>
          <label class="admin-form__label">Text</label>
          <textarea name="text" class="admin-input" rows="4"></textarea>
          <p class="admin-form__hint">Markdown or plain text.</p>
        </div>

        <div class="admin-form__field hidden" data-field-url>
          <label class="admin-form__label">URL</label>
          <input name="url" class="admin-input" placeholder="https://..." />
          <p class="admin-form__hint">
            For images / media: full URL (згодом замінимо на upload через
            storage).
          </p>
        </div>

        <div class="admin-form__footer">
          <button
            type="button"
            class="admin-btn admin-btn--ghost"
            data-admin-modal-close
          >
            Cancel
          </button>
          <button type="submit" class="admin-btn admin-btn--primary">
            Create
          </button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline>
    (function () {
      const projectId = "{id}";

      // ===== PROJECT FORM SAVE =====
      const projectForm = document.querySelector("[data-project-form]");
      const projectSaveBtn = document.querySelector("[data-project-save]");

      projectSaveBtn?.addEventListener("click", async () => {
        if (!projectForm) return;
        const formData = new FormData(projectForm);

        const payload = {
          slug: formData.get("slug") || null,
          title_en: formData.get("title_en") || null,
          title_uk: formData.get("title_uk") || null,
          description_en: formData.get("description_en") || null,
          description_uk: formData.get("description_uk") || null,
          thumbnail_url: formData.get("thumbnail_url") || null,
          cover_url: formData.get("cover_url") || null,
          category_en: formData.get("category_en") || null,
          category_uk: formData.get("category_uk") || null,
          status: formData.get("status") || "draft",
          is_published: projectForm.querySelector(
            "input[name='is_published']"
          )?.checked,
          is_protected: projectForm.querySelector(
            "input[name='is_protected']"
          )?.checked,
          password_hash: formData.get("password_hash") || null,
        };

        const res = await fetch(`/api/admin/projects/${projectId}`, {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });

        if (!res.ok) {
          console.error("Project update failed", await res.text());
          alert("Failed to save project");
          return;
        }

        alert("Project saved");
      });

      // ===== BLOCKS: create / delete / drag&drop =====
      const table = document.querySelector("[data-blocks-table]");
      if (!table) return;

      const createForm = document.querySelector("[data-block-create-form]");
      const fieldText = createForm?.querySelector("[data-field-text]");
      const fieldUrl = createForm?.querySelector("[data-field-url]");
      const tbody = table.querySelector("tbody");

      // Toggle fields by type
      createForm
        ?.querySelector("select[name='type']")
        ?.addEventListener("change", (e) => {
          const value = e.target.value;
          if (value === "text") {
            fieldText?.classList.remove("hidden");
            fieldUrl?.classList.add("hidden");
          } else {
            fieldText?.classList.add("hidden");
            fieldUrl?.classList.remove("hidden");
          }
        });

      // Create block
      createForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const form = e.target;
        const type = form.type.value;
        const layout = form.layout.value || "1/1";

        let content = {};

        if (type === "text") {
          content = { text: form.text.value || "" };
        } else if (type === "image") {
          content = {
            url: form.url.value || "",
            mediaType: "image",
          };
        } else if (type === "media") {
          content = {
            url: form.url.value || "",
            mediaType: "video",
            autoplay: true,
            loop: true,
            muted: true,
          };
        }

        const payload = { type, layout, content };

        const res = await fetch(`/api/admin/projects/${projectId}/blocks`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });

        if (!res.ok) {
          console.error("Create block failed", await res.text());
          return;
        }

        location.reload();
      });

      // Delete block
      table.addEventListener("click", async (e) => {
        const btn = e.target.closest("[data-block-delete]");
        if (!btn) return;
        const row = btn.closest("tr");
        const blockId = row?.dataset.blockId;
        if (!blockId) return;

        if (!confirm("Delete this block?")) return;

        const res = await fetch(`/api/admin/projects/${projectId}/${blockId}`, {
          method: "DELETE",
        });

        if (!res.ok) {
          console.error("Delete block failed", await res.text());
          return;
        }

        row?.remove();
      });

      // Drag & drop reorder
      let dragSrcRow = null;

      tbody
        .querySelectorAll("tr[draggable='true']")
        .forEach((row) => {
          row.addEventListener("dragstart", (e) => {
            dragSrcRow = row;
            e.dataTransfer.effectAllowed = "move";
            row.classList.add("opacity-60");
          });

          row.addEventListener("dragend", () => {
            dragSrcRow = null;
            row.classList.remove("opacity-60");
          });

          row.addEventListener("dragover", (e) => {
            e.preventDefault();
            e.dataTransfer.dropEffect = "move";
          });

          row.addEventListener("drop", async (e) => {
            e.preventDefault();
            const targetRow = row;
            if (!dragSrcRow || dragSrcRow === targetRow) return;

            const rows = Array.from(tbody.querySelectorAll("tr"));
            const srcIndex = rows.indexOf(dragSrcRow);
            const targetIndex = rows.indexOf(targetRow);

            if (srcIndex < targetIndex) {
              tbody.insertBefore(dragSrcRow, targetRow.nextSibling);
            } else {
              tbody.insertBefore(dragSrcRow, targetRow);
            }

            const newOrder = Array.from(tbody.querySelectorAll("tr")).map(
              (r) => r.dataset.blockId
            );

            const res = await fetch(
              `/api/admin/projects/${projectId}/reorder`,
              {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ order: newOrder }),
              }
            );

            if (!res.ok) {
              console.error("Reorder failed", await res.text());
            } else {
              Array.from(tbody.querySelectorAll("tr")).forEach((r, idx) => {
                const posCell = r.querySelector("td:first-child");
                if (posCell) posCell.textContent = String(idx);
              });
            }
          });
        });
    })();
  </script>
</AdminLayout>
