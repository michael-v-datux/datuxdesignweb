---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import AdminPageHeader from "../../../../components/admin/AdminPageHeader.astro";
import BlockMediaFields from "../../../../components/admin/BlockMediaFields.astro";
import BlockLayoutFields from "../../../../components/admin/BlockLayoutFields.astro";
import { getAdminSupabase } from "../../../../lib/supabaseServer";
import { fetchProjectLayout } from "../../../../lib/projects/layout";
import type { ProjectLayout } from "../../../../lib/projects/types";

const supabase = getAdminSupabase();

const { id } = Astro.params;

const { data: project, error: projectError } = await supabase
  .from("projects")
  .select("*")
  .eq("id", id)
  .maybeSingle();

if (projectError) {
  console.error(projectError);
}

let layout: ProjectLayout = { rows: [] };
try {
  layout = await fetchProjectLayout(supabase, id!);
} catch (layoutError) {
  console.error(layoutError);
}

const slug = project?.slug ?? "";
const editState = JSON.stringify({
  projectId: id,
  slug,
  layout,
}).replace(/</g, "\\u003c");
---

<AdminLayout title={`Edit: ${project?.slug ?? "Project"}`} activeNav="dashboard">
  <AdminPageHeader
    title={project?.title_en || project?.title_uk || "Edit project"}
    subtitle="Update metadata, media, and content blocks."
    breadcrumbs={[
      { label: "Projects", href: "/admin/dashboard" },
      { label: project?.slug ?? "Edit" },
    ]}
  />

  <div class="admin-edit-toolbar">
    <p>
      {slug ? `/${slug}` : "Set a slug to preview on the public site"}
    </p>
    {slug && (
      <div class="admin-edit-toolbar__preview">
        <a
          href={`/en/projects/${slug}`}
          target="_blank"
          rel="noopener noreferrer"
          class="admin-btn admin-btn--ghost"
        >
          Preview EN ↗
        </a>
        <a
          href={`/uk/projects/${slug}`}
          target="_blank"
          rel="noopener noreferrer"
          class="admin-btn admin-btn--ghost"
        >
          Preview UK ↗
        </a>
      </div>
    )}
  </div>

  <div class="admin-edit-layout">
    <div class="admin-edit-main admin-section-gap">
  <details class="admin-accordion" data-admin-accordion="metadata" open>
    <summary>Project metadata</summary>
    <div class="admin-accordion__body">
  <section class="admin-table-card" style="margin-bottom:0;">
    <div class="admin-table-card__header">
      <h2>Details</h2>
    </div>

    <div class="admin-card__body">
      <form class="admin-form" data-project-form>
        <div class="admin-form__field admin-form__field--inline">
          <div>
            <label class="admin-form__label">Slug</label>
            <input
              class="admin-input"
              name="slug"
              value={project?.slug ?? ""}
              placeholder="search-engine"
            />
          </div>
          <div>
            <label class="admin-form__label">Status</label>
            <select name="status" class="admin-input">
              <option
                value="draft"
                selected={project?.status === "draft" || !project?.status}
              >
                Draft
              </option>
              <option
                value="published"
                selected={project?.status === "published"}
              >
                Published
              </option>
            </select>
          </div>
        </div>

        <div class="admin-form__field admin-form__field--inline">
          <div>
            <label class="admin-form__label">Title (EN)</label>
            <input
              class="admin-input"
              name="title_en"
              value={project?.title_en ?? ""}
              placeholder="Search Engine"
            />
          </div>
          <div>
            <label class="admin-form__label">Title (UK)</label>
            <input
              class="admin-input"
              name="title_uk"
              value={project?.title_uk ?? ""}
              placeholder="Пошуковий проєкт"
            />
          </div>
        </div>

        <div class="admin-form__field admin-form__field--inline">
          <div>
            <label class="admin-form__label">Category (EN)</label>
            <input
              class="admin-input"
              name="category_en"
              value={project?.category_en ?? ""}
              placeholder="Search"
            />
          </div>
          <div>
            <label class="admin-form__label">Category (UK)</label>
            <input
              class="admin-input"
              name="category_uk"
              value={project?.category_uk ?? ""}
              placeholder="Пошук"
            />
          </div>
        </div>

        <div class="admin-form__field">
          <label class="admin-form__label">Description (EN)</label>
          <textarea
            class="admin-input"
            name="description_en"
            rows="3"
          >{project?.description_en ?? ""}</textarea>
        </div>

        <div class="admin-form__field">
          <label class="admin-form__label">Description (UK)</label>
          <textarea
            class="admin-input"
            name="description_uk"
            rows="3"
          >{project?.description_uk ?? ""}</textarea>
        </div>

        <div class="admin-form__field admin-form__field--inline">
          <div>
            <label class="admin-form__label">Thumbnail</label>
            <input
              type="file"
              class="admin-input admin-file-input"
              data-project-upload
              data-target="thumbnail_url"
              accept="image/jpeg,image/png,image/gif,image/webp"
            />
            <span class="admin-file-control__name" data-file-label>No file chosen</span>
            <input
              class="admin-input"
              name="thumbnail_url"
              value={project?.thumbnail_url ?? ""}
              placeholder="https://..."
            />
          </div>
          <div>
            <label class="admin-form__label">Cover</label>
            <input
              type="file"
              class="admin-input admin-file-input"
              data-project-upload
              data-target="cover_url"
              accept="image/jpeg,image/png,image/gif,image/webp"
            />
            <span class="admin-file-control__name" data-file-label>No file chosen</span>
            <input
              class="admin-input"
              name="cover_url"
              value={project?.cover_url ?? ""}
              placeholder="https://..."
            />
          </div>
        </div>

        <div class="admin-form__field admin-form__field--inline">
          <label class="admin-form__checkbox-row">
            <input
              id="is_published"
              type="checkbox"
              name="is_published"
              checked={project?.is_published ?? false}
            />
            <span class="admin-form__label">Published</span>
          </label>

          <label class="admin-form__checkbox-row">
            <input
              id="is_protected"
              type="checkbox"
              name="is_protected"
              checked={project?.is_protected ?? false}
            />
            <span class="admin-form__label">Password protected</span>
          </label>
        </div>

        <div class="admin-form__field">
          <label class="admin-form__label">New password</label>
          <input
            class="admin-input"
            type="password"
            name="password"
            value=""
            placeholder="Leave empty to keep current"
            autocomplete="new-password"
          />
          <p class="admin-form__hint">
            Введіть новий пароль лише якщо хочете змінити. Зберігається як bcrypt hash.
          </p>
        </div>
      </form>
    </div>
  </section>
    </div>
  </details>

  <details class="admin-accordion" data-admin-accordion="blocks" open>
    <summary>Page builder</summary>
    <div class="admin-accordion__body">
  <section class="admin-table-card" style="margin-bottom:0;">
    <div class="admin-table-card__header">
      <h2>Rows &amp; columns</h2>
      <button
        class="admin-btn admin-btn--primary"
        type="button"
        data-layout-add-row
      >
        + Add row
      </button>
    </div>

    <div class="admin-card__body">
      <div class="admin-layout-builder" data-layout-builder></div>
    </div>
  </section>
    </div>
  </details>
    </div>

    <aside class="admin-edit-preview-panel">
      <div class="admin-edit-preview-panel__header">
        <h3>Live preview</h3>
        <div class="admin-preview-lang" data-preview-lang>
          <button type="button" data-lang="en" class="is-active">EN</button>
          <button type="button" data-lang="uk">UK</button>
        </div>
      </div>
      <div class="admin-edit-preview-panel__body">
        <div id="project-live-preview" data-project-preview></div>
        <button
          type="button"
          class="admin-btn admin-btn--primary"
          style="width:100%; margin-top:14px;"
          data-layout-add-row
        >
          + Add row
        </button>
      </div>
    </aside>
  </div>

  <div class="admin-edit-actions">
    <a href="/admin/dashboard" class="admin-btn admin-btn--ghost" data-project-cancel>
      Cancel
    </a>
    <button type="button" class="admin-btn admin-btn--primary" data-project-save>
      Save changes
    </button>
  </div>

  <div class="admin-modal" data-admin-modal="add-block" aria-hidden="true">
    <div class="admin-modal__backdrop" data-admin-modal-close></div>
    <div class="admin-modal__dialog">
      <div class="admin-modal__header">
        <h3 class="admin-modal__title">Add block</h3>
        <button class="admin-modal__close" data-admin-modal-close type="button">×</button>
      </div>
      <form class="admin-form" data-block-create-form>
        <input type="hidden" name="column_id" value="" />
        <div class="admin-form__field">
          <label class="admin-form__label">Type</label>
          <select name="type" class="admin-input" required>
            <option value="text">Text</option>
            <option value="image">Image</option>
            <option value="media">Media</option>
          </select>
        </div>
        <BlockLayoutFields showWidth={false} />
        <div class="admin-form__field" data-field-text>
          <label class="admin-form__label">Text (EN)</label>
          <textarea name="text_en" class="admin-input" rows="3" data-rich-text></textarea>
        </div>
        <div class="admin-form__field" data-field-text>
          <label class="admin-form__label">Text (UK)</label>
          <textarea name="text_uk" class="admin-input" rows="3" data-rich-text></textarea>
        </div>
        <BlockMediaFields />
        <div class="admin-form__footer">
          <button
            type="button"
            class="admin-btn admin-btn--ghost"
            data-admin-modal-close
          >
            Cancel
          </button>
          <button type="submit" class="admin-btn admin-btn--primary">
            Create
          </button>
        </div>
      </form>
    </div>
  </div>

  <div class="admin-modal" data-admin-modal="edit-block" aria-hidden="true">
    <div class="admin-modal__backdrop" data-admin-modal-close></div>
    <div class="admin-modal__dialog">
      <div class="admin-modal__header">
        <h3 class="admin-modal__title">Edit block</h3>
        <button class="admin-modal__close" data-admin-modal-close type="button">×</button>
      </div>
      <form class="admin-form" data-block-edit-form>
        <input type="hidden" name="block_id" value="" />
        <div class="admin-form__field">
          <label class="admin-form__label">Type</label>
          <select name="type" class="admin-input" required>
            <option value="text">Text</option>
            <option value="image">Image</option>
            <option value="media">Media</option>
          </select>
        </div>
        <BlockLayoutFields showWidth={false} />
        <div class="admin-form__field" data-field-text>
          <label class="admin-form__label">Text (EN)</label>
          <textarea name="text_en" class="admin-input" rows="3" data-rich-text></textarea>
        </div>
        <div class="admin-form__field" data-field-text>
          <label class="admin-form__label">Text (UK)</label>
          <textarea name="text_uk" class="admin-input" rows="3" data-rich-text></textarea>
        </div>
        <BlockMediaFields />
        <div class="admin-form__footer">
          <button type="button" class="admin-btn admin-btn--ghost" data-admin-modal-close>
            Cancel
          </button>
          <button type="submit" class="admin-btn admin-btn--primary">Save block</button>
        </div>
      </form>
    </div>
  </div>

  <script id="project-edit-state" type="application/json" set:html={editState} />
  <script type="module" src="/scripts/admin/project-edit.js"></script>
</AdminLayout>
