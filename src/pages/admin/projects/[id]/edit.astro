---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import BlockMediaFields from "../../../../components/admin/BlockMediaFields.astro";
import { getAdminSupabase } from "../../../../lib/supabaseServer";
import { normalizeBlock, blockText } from "../../../../lib/projects/blocks";

const supabase = getAdminSupabase();

const { id } = Astro.params;

const { data: project, error: projectError } = await supabase
  .from("projects")
  .select("*")
  .eq("id", id)
  .maybeSingle();

if (projectError) {
  console.error(projectError);
}

const { data: blocksRaw, error: blocksError } = await supabase
  .from("projects_blocks")
  .select("*")
  .eq("project_id", id)
  .order("position", { ascending: true });

const blocks = (blocksRaw ?? []).map((row) =>
  normalizeBlock(row as Record<string, unknown>)
);

if (blocksError) {
  console.error(blocksError);
}

const slug = project?.slug ?? "";
const editState = JSON.stringify({
  projectId: id,
  slug,
  blocks,
}).replace(/</g, "\\u003c");
---

<AdminLayout title={`Edit: ${project?.slug ?? "Project"}`} section="projects">
  <div class="admin-edit-toolbar">
    <p class="text-sm text-slate-500">
      {slug ? `/${slug}` : "Set a slug to preview"}
    </p>
    {slug && (
      <div class="admin-edit-toolbar__preview">
        <a
          href={`/en/projects/${slug}`}
          target="_blank"
          rel="noopener noreferrer"
          class="admin-btn admin-btn--ghost"
        >
          Preview EN ↗
        </a>
        <a
          href={`/uk/projects/${slug}`}
          target="_blank"
          rel="noopener noreferrer"
          class="admin-btn admin-btn--ghost"
        >
          Preview UK ↗
        </a>
      </div>
    )}
  </div>

  <section class="admin-table-card">
    <div class="admin-table-card__header">
      <h2>Project info</h2>
      <button
        class="admin-btn admin-btn--primary"
        type="button"
        data-project-save
      >
        Save changes
      </button>
    </div>

    <div class="p-4">
      <form class="admin-form" data-project-form>
        <div class="admin-form__field admin-form__field--inline">
          <div>
            <label class="admin-form__label">Slug</label>
            <input
              class="admin-input"
              name="slug"
              value={project?.slug ?? ""}
              placeholder="search-engine"
            />
          </div>
          <div>
            <label class="admin-form__label">Status</label>
            <select name="status" class="admin-input">
              <option
                value="draft"
                selected={project?.status === "draft" || !project?.status}
              >
                Draft
              </option>
              <option
                value="published"
                selected={project?.status === "published"}
              >
                Published
              </option>
            </select>
          </div>
        </div>

        <div class="admin-form__field admin-form__field--inline">
          <div>
            <label class="admin-form__label">Title (EN)</label>
            <input
              class="admin-input"
              name="title_en"
              value={project?.title_en ?? ""}
              placeholder="Search Engine"
            />
          </div>
          <div>
            <label class="admin-form__label">Title (UK)</label>
            <input
              class="admin-input"
              name="title_uk"
              value={project?.title_uk ?? ""}
              placeholder="Пошуковий проєкт"
            />
          </div>
        </div>

        <div class="admin-form__field admin-form__field--inline">
          <div>
            <label class="admin-form__label">Category (EN)</label>
            <input
              class="admin-input"
              name="category_en"
              value={project?.category_en ?? ""}
              placeholder="Search"
            />
          </div>
          <div>
            <label class="admin-form__label">Category (UK)</label>
            <input
              class="admin-input"
              name="category_uk"
              value={project?.category_uk ?? ""}
              placeholder="Пошук"
            />
          </div>
        </div>

        <div class="admin-form__field">
          <label class="admin-form__label">Description (EN)</label>
          <textarea
            class="admin-input"
            name="description_en"
            rows="3"
          >{project?.description_en ?? ""}</textarea>
        </div>

        <div class="admin-form__field">
          <label class="admin-form__label">Description (UK)</label>
          <textarea
            class="admin-input"
            name="description_uk"
            rows="3"
          >{project?.description_uk ?? ""}</textarea>
        </div>

        <div class="admin-form__field admin-form__field--inline">
          <div>
            <label class="admin-form__label">Thumbnail</label>
            <input
              type="file"
              class="admin-input mb-2"
              data-project-upload
              data-target="thumbnail_url"
              accept="image/jpeg,image/png,image/gif,image/webp"
            />
            <input
              class="admin-input"
              name="thumbnail_url"
              value={project?.thumbnail_url ?? ""}
              placeholder="https://..."
            />
          </div>
          <div>
            <label class="admin-form__label">Cover</label>
            <input
              type="file"
              class="admin-input mb-2"
              data-project-upload
              data-target="cover_url"
              accept="image/jpeg,image/png,image/gif,image/webp"
            />
            <input
              class="admin-input"
              name="cover_url"
              value={project?.cover_url ?? ""}
              placeholder="https://..."
            />
          </div>
        </div>

        <div class="admin-form__field admin-form__field--inline">
          <div class="flex items-center gap-2">
            <input
              id="is_published"
              type="checkbox"
              name="is_published"
              checked={project?.is_published ?? false}
            />
            <label class="admin-form__label" for="is_published">
              Published
            </label>
          </div>

          <div class="flex items-center gap-2">
            <input
              id="is_protected"
              type="checkbox"
              name="is_protected"
              checked={project?.is_protected ?? false}
            />
            <label class="admin-form__label" for="is_protected">
              Password protected
            </label>
          </div>
        </div>

        <div class="admin-form__field">
          <label class="admin-form__label">New password</label>
          <input
            class="admin-input"
            type="password"
            name="password"
            value=""
            placeholder="Leave empty to keep current"
            autocomplete="new-password"
          />
          <p class="admin-form__hint">
            Введіть новий пароль лише якщо хочете змінити. Зберігається як bcrypt hash.
          </p>
        </div>
      </form>
    </div>
  </section>

  <section class="admin-table-card">
    <div class="admin-table-card__header">
      <h2>Blocks</h2>
      <button
        class="admin-btn admin-btn--primary"
        type="button"
        data-admin-modal-open="add-block"
      >
        + Add block
      </button>
    </div>

    <table class="admin-table" data-blocks-table data-project-id={id}>
      <thead>
        <tr>
          <th>Pos</th>
          <th>Type</th>
          <th>Layout</th>
          <th>Preview</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {blocks?.map((b) => {
          const preview =
            b.type === "text"
              ? blockText(b.content, "en")
              : b.content?.url
                ? `Media: ${String(b.content.url).split("/").slice(-1)[0]}`
                : "";
          const short =
            preview.length > 60 ? preview.slice(0, 60) + "…" : preview;
          return (
          <tr data-block-id={b.id} draggable="true">
            <td>{b.position}</td>
            <td>{b.type}</td>
            <td>{b.layout}</td>
            <td>{short}</td>
            <td style="text-align:right;">
              <div class="admin-table__actions">
                <button
                  type="button"
                  class="admin-btn admin-btn--ghost"
                  data-block-edit
                >
                  Edit
                </button>
                <button
                  type="button"
                  class="admin-btn admin-btn--ghost"
                  data-block-delete
                >
                  Delete
                </button>
              </div>
            </td>
          </tr>
          );
        })}
      </tbody>
    </table>
  </section>

  <div class="admin-modal" data-admin-modal="add-block" aria-hidden="true">
    <div class="admin-modal__backdrop" data-admin-modal-close></div>
    <div class="admin-modal__dialog">
      <div class="admin-modal__header">
        <h3 class="admin-modal__title">Add block</h3>
        <button class="admin-modal__close" data-admin-modal-close type="button">×</button>
      </div>
      <form class="admin-form" data-block-create-form>
        <div class="admin-form__field">
          <label class="admin-form__label">Type</label>
          <select name="type" class="admin-input" required>
            <option value="text">Text</option>
            <option value="image">Image</option>
            <option value="media">Media</option>
          </select>
        </div>
        <div class="admin-form__field">
          <label class="admin-form__label">Layout</label>
          <select name="layout" class="admin-input" required>
            <option value="1/1">1/1 (default)</option>
            <option value="1/2">1/2</option>
            <option value="1/3">1/3</option>
            <option value="1/4">1/4</option>
            <option value="full">Full width</option>
          </select>
        </div>
        <div class="admin-form__field" data-field-text>
          <label class="admin-form__label">Text (EN)</label>
          <textarea name="text_en" class="admin-input" rows="3"></textarea>
        </div>
        <div class="admin-form__field" data-field-text>
          <label class="admin-form__label">Text (UK)</label>
          <textarea name="text_uk" class="admin-input" rows="3"></textarea>
        </div>
        <BlockMediaFields />
        <div class="admin-form__footer">
          <button
            type="button"
            class="admin-btn admin-btn--ghost"
            data-admin-modal-close
          >
            Cancel
          </button>
          <button type="submit" class="admin-btn admin-btn--primary">
            Create
          </button>
        </div>
      </form>
    </div>
  </div>

  <div class="admin-modal" data-admin-modal="edit-block" aria-hidden="true">
    <div class="admin-modal__backdrop" data-admin-modal-close></div>
    <div class="admin-modal__dialog">
      <div class="admin-modal__header">
        <h3 class="admin-modal__title">Edit block</h3>
        <button class="admin-modal__close" data-admin-modal-close type="button">×</button>
      </div>
      <form class="admin-form" data-block-edit-form>
        <input type="hidden" name="block_id" value="" />
        <div class="admin-form__field">
          <label class="admin-form__label">Type</label>
          <select name="type" class="admin-input" required>
            <option value="text">Text</option>
            <option value="image">Image</option>
            <option value="media">Media</option>
          </select>
        </div>
        <div class="admin-form__field">
          <label class="admin-form__label">Layout</label>
          <select name="layout" class="admin-input" required>
            <option value="1/1">1/1 (default)</option>
            <option value="1/2">1/2</option>
            <option value="1/3">1/3</option>
            <option value="1/4">1/4</option>
            <option value="full">Full width</option>
          </select>
        </div>
        <div class="admin-form__field" data-field-text>
          <label class="admin-form__label">Text (EN)</label>
          <textarea name="text_en" class="admin-input" rows="3"></textarea>
        </div>
        <div class="admin-form__field" data-field-text>
          <label class="admin-form__label">Text (UK)</label>
          <textarea name="text_uk" class="admin-input" rows="3"></textarea>
        </div>
        <BlockMediaFields />
        <div class="admin-form__footer">
          <button type="button" class="admin-btn admin-btn--ghost" data-admin-modal-close>
            Cancel
          </button>
          <button type="submit" class="admin-btn admin-btn--primary">Save block</button>
        </div>
      </form>
    </div>
  </div>

  <script id="project-edit-state" type="application/json" set:html={editState} />
  <script type="module" src="/scripts/admin/project-edit.js"></script>
</AdminLayout>
