---
import AdminLayout from "../../../../../layouts/AdminLayout.astro";
export const prerender = false;
---

<script>
  if (!localStorage.getItem("admin")) {
    window.location.href = "/admin";
  }
</script>

<AdminLayout title="Edit Project">
  <h1 class="text-2xl mb-6 font-semibold">Edit Project</h1>

  <form id="project-form" class="flex flex-col gap-4 max-w-lg">
    <input id="title_en" name="title_en" class="p-2 border rounded" placeholder="Title EN" />
    <input id="title_uk" name="title_uk" class="p-2 border rounded" placeholder="Title UK" />

    <textarea id="description_en" name="description_en" class="p-2 border rounded" placeholder="Description EN"></textarea>
    <textarea id="description_uk" name="description_uk" class="p-2 border rounded" placeholder="Description UK"></textarea>

    <input id="thumbnail_url" name="thumbnail_url" class="p-2 border rounded" placeholder="Thumbnail URL" />

    <label class="flex items-center gap-2">
      <input id="is_protected" name="is_protected" type="checkbox" />
      Password Protected?
    </label>

    <input id="password" name="password" class="p-2 border rounded" placeholder="Password" />

    <select id="status" name="status" class="p-2 border rounded">
      <option value="draft">Draft</option>
      <option value="published">Published</option>
    </select>

    <button class="bg-blue-500 text-white p-2 rounded hover:bg-blue-600">Update</button>
  </form>

  <!-- ВАЖЛИВО: вилучено drag-blocks.js -->
  <script type="module" src="/scripts/admin/edit.js"></script>
</AdminLayout>
