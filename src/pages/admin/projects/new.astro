---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import AdminPageHeader from "../../../components/admin/AdminPageHeader.astro";
import { getAdminSupabase } from "../../../lib/supabaseServer";
import bcrypt from "bcryptjs";

const supabase = getAdminSupabase();

let error = null;

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();

  const slug = (formData.get("slug") || "").toString().trim();
  const title_en = (formData.get("title_en") || "").toString().trim();
  const title_uk = (formData.get("title_uk") || "").toString().trim();
  const description_en = (formData.get("description_en") || "").toString().trim();
  const description_uk = (formData.get("description_uk") || "").toString().trim();
  const thumbnail_url = (formData.get("thumbnail_url") || "").toString().trim();
  const cover_url = (formData.get("cover_url") || "").toString().trim();
  const category_en = (formData.get("category_en") || "").toString().trim();
  const category_uk = (formData.get("category_uk") || "").toString().trim();
  const status = (formData.get("status") || "draft").toString().trim();

  const is_published =
    formData.get("is_published") === "on" || formData.get("is_published") === "true";
  const is_protected =
    formData.get("is_protected") === "on" || formData.get("is_protected") === "true";

  const password = (formData.get("password") || "").toString().trim();
  let password_hash: string | null = null;
  if (password) {
    password_hash = await bcrypt.hash(password, 10);
  }

  if (!slug || !title_en || !title_uk) {
    error = "Slug, Title EN та Title UK є обов'язковими полями.";
  } else {
    const payload: Record<string, any> = {
      slug,
      title_en,
      title_uk,
      description_en: description_en || null,
      description_uk: description_uk || null,
      thumbnail_url: thumbnail_url || null,
      cover_url: cover_url || null,
      category_en: category_en || null,
      category_uk: category_uk || null,
      status: status || "draft",
      is_published,
      is_protected,
      password_hash,
    };

    const { data, error: dbError } = await supabase
      .from("projects")
      .insert(payload)
      .select("id, slug")
      .single();

    if (dbError) {
      console.error("Create project error", dbError);
      error = dbError.message;
    } else if (data?.id) {
      // ✅ Успішно створили — редіректимось в редагування + блоки
      return Astro.redirect(`/admin/projects/${data.id}/edit`);
    } else {
      error = "Unknown error while creating project.";
    }
  }
}
---

<AdminLayout title="Create project" activeNav="new">
  <AdminPageHeader
    title="New project"
    subtitle="Basic metadata first — blocks and uploads on the edit screen."
    breadcrumbs={[
      { label: "Projects", href: "/admin/dashboard" },
      { label: "New" },
    ]}
  />

  <section class="admin-table-card">
    <div class="admin-table-card__header">
      <h2>Project details</h2>
    </div>

    <div class="admin-card__body">
      {error && (
        <div class="admin-alert admin-alert--error">
          {error}
        </div>
      )}

      <form class="admin-form" method="POST">
        <div class="admin-form__field admin-form__field--inline">
          <div>
            <label class="admin-form__label">Slug *</label>
            <input
              class="admin-input"
              name="slug"
              placeholder="search-engine"
              required
            />
            <p class="admin-form__hint">
              Використовується в URL: /portfolio/&lt;slug&gt;.
            </p>
          </div>
          <div>
            <label class="admin-form__label">Status</label>
            <select name="status" class="admin-input">
              <option value="draft">Draft</option>
              <option value="published">Published</option>
            </select>
          </div>
        </div>

        <div class="admin-form__field admin-form__field--inline">
          <div>
            <label class="admin-form__label">Title (EN) *</label>
            <input
              class="admin-input"
              name="title_en"
              placeholder="Search Engine"
              required
            />
          </div>
          <div>
            <label class="admin-form__label">Title (UK) *</label>
            <input
              class="admin-input"
              name="title_uk"
              placeholder="Пошуковий проєкт"
              required
            />
          </div>
        </div>

        <div class="admin-form__field admin-form__field--inline">
          <div>
            <label class="admin-form__label">Category (EN)</label>
            <input
              class="admin-input"
              name="category_en"
              placeholder="Search"
            />
          </div>
          <div>
            <label class="admin-form__label">Category (UK)</label>
            <input
              class="admin-input"
              name="category_uk"
              placeholder="Пошук"
            />
          </div>
        </div>

        <div class="admin-form__field">
          <label class="admin-form__label">Short Description (EN)</label>
          <textarea
            class="admin-input"
            name="description_en"
            rows="3"
          ></textarea>
        </div>

        <div class="admin-form__field">
          <label class="admin-form__label">Short Description (UK)</label>
          <textarea
            class="admin-input"
            name="description_uk"
            rows="3"
          ></textarea>
        </div>


        <div class="admin-form__field admin-form__field--inline">
          <div>
            <label class="admin-form__label">Thumbnail URL</label>
            <input
              class="admin-input"
              name="thumbnail_url"
              placeholder="https://..."
            />
            <p class="admin-form__hint">Upload files after creation on the edit page.</p>
          </div>
          <div>
            <label class="admin-form__label">Cover URL</label>
            <input
              class="admin-input"
              name="cover_url"
              placeholder="https://..."
            />
          </div>
        </div>

        <div class="admin-form__field admin-form__field--inline">
          <label class="admin-form__checkbox-row">
            <input id="is_published" type="checkbox" name="is_published" />
            <span class="admin-form__label">Published</span>
          </label>

          <label class="admin-form__checkbox-row">
            <input id="is_protected" type="checkbox" name="is_protected" />
            <span class="admin-form__label">Password protected</span>
          </label>
        </div>

        <div class="admin-form__field">
          <label class="admin-form__label">Password (optional)</label>
          <input
            class="admin-input"
            type="password"
            name="password"
            placeholder="Set if project is protected"
            autocomplete="new-password"
          />
          <p class="admin-form__hint">
            Зберігається як bcrypt hash. Залиште порожнім, якщо пароль не потрібен.
          </p>
        </div>

        <div class="admin-form__footer">
          <a href="/admin/dashboard" class="admin-btn admin-btn--ghost">
            Cancel
          </a>
          <button type="submit" class="admin-btn admin-btn--primary">
            Create project
          </button>
        </div>

        <p class="admin-form__hint" style="margin-top: 16px;">
          Після створення проєкту ви будете перенаправлені на сторінку редагування,
          де можна налаштувати контентні блоки (текст, зображення, медіа, грід 1/2/3/4, full width).
        </p>
      </form>
    </div>
  </section>
</AdminLayout>