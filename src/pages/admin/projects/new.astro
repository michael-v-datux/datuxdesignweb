---
import AdminLayout from "../../../layouts/AdminLayout.astro";
export const prerender = false;
---

<script>
  if (!localStorage.getItem("admin")) {
    window.location.href = "/admin";
  }
</script>

<AdminLayout title="New Project">
  <h1 class="text-2xl mb-6 font-semibold">New Project</h1>

  <form id="new-project-form" class="flex flex-col gap-4 max-w-lg">
    <input name="title_en" placeholder="Title EN" class="p-2 border rounded" />

    <input name="title_uk" placeholder="Title UK" class="p-2 border rounded" />

    <textarea name="description_en" placeholder="Description EN" class="p-2 border rounded"></textarea>

    <textarea name="description_uk" placeholder="Description UK" class="p-2 border rounded"></textarea>

    <input name="thumbnail_url" placeholder="Thumbnail URL" class="p-2 border rounded" />

    <label class="flex items-center gap-2">
      <input type="checkbox" name="is_protected" />
      Password Protected?
    </label>

    <input name="password" placeholder="Password" class="p-2 border rounded" />

    <select name="status" class="p-2 border rounded">
      <option value="draft">Draft</option>
      <option value="published">Published</option>
    </select>

    <button class="bg-green-500 text-white p-2 rounded hover:bg-green-600">Create</button>
  </form>

  <script type="module" src="/scripts/admin/new.js"></script>
</AdminLayout>
