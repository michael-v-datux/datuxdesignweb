---
import AdminLayout from "../../layouts/AdminLayout.astro";
export const prerender = false;
---

<AdminLayout title="Admin Login">
  <div class="max-w-sm mx-auto mt-24 bg-white shadow rounded-lg p-6 border border-slate-200">
    <h1 class="text-xl font-semibold mb-4 text-center">Admin Login</h1>

    <form id="login-form" class="flex flex-col gap-4">
      <div class="flex flex-col gap-1">
        <label for="username" class="text-sm text-slate-700">Username</label>
        <input
          id="username"
          type="text"
          name="username"
          placeholder="Username"
          autocomplete="username"
          class="p-2 border rounded"
          required
        />
      </div>

      <div class="flex flex-col gap-1">
        <label for="password" class="text-sm text-slate-700">Password</label>
        <input
          id="password"
          type="password"
          name="password"
          placeholder="Password"
          autocomplete="current-password"
          class="p-2 border rounded"
          required
        />
      </div>

      <label class="flex items-center gap-2 text-sm text-slate-600">
        <input
          id="remember-password"
          type="checkbox"
          class="h-4 w-4"
        />
        <span>Remember password on this device</span>
      </label>

      <p id="login-error" class="text-sm text-red-500 min-h-[1.25rem]"></p>

      <button
        type="submit"
        class="bg-blue-500 hover:bg-blue-600 text-white p-2 rounded transition"
      >
        Login
      </button>
    </form>

    <p class="mt-3 text-xs text-slate-500">
      Credentials come from <code class="font-mono">ADMIN_USER</code> / <code class="font-mono">ADMIN_PASS</code>.
    </p>
  </div>

  <script>
    const form = document.getElementById("login-form");
    const usernameInput = document.getElementById("username");
    const passwordInput = document.getElementById("password");
    const rememberCheckbox = document.getElementById("remember-password");
    const errorEl = document.getElementById("login-error");

    // Спробувати відновити логін/пароль із localStorage
    try {
      const saved = JSON.parse(localStorage.getItem("admin-login") || "null");
      if (saved && saved.username) {
        usernameInput.value = saved.username;
      }
      if (saved && saved.rememberPassword && saved.password) {
        rememberCheckbox.checked = true;
        passwordInput.value = saved.password;
      }
    } catch (e) {
      console.warn("Failed to parse admin-login from localStorage", e);
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      errorEl.textContent = "";

      const username = usernameInput.value.trim();
      const password = passwordInput.value;

      try {
        const res = await fetch("/api/admin-login", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ username, password }),
        });

        if (!res.ok) {
          errorEl.textContent = "Invalid credentials. Please try again.";
          return;
        }

        // Зберігаємо інформацію для автозаповнення
        const toSave = { username };
        if (rememberCheckbox.checked) {
          toSave.rememberPassword = true;
          toSave.password = password;
        }

        localStorage.setItem("admin-login", JSON.stringify(toSave));
        localStorage.setItem("admin", "true");

        window.location.href = "/admin/dashboard";
      } catch (err) {
        console.error(err);
        errorEl.textContent = "Something went wrong. Please try again.";
      }
    });
  </script>
</AdminLayout>
