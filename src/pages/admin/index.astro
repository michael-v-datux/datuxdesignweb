---
import AdminLayout from "../../layouts/AdminLayout.astro";
export const prerender = false;
---

<AdminLayout title="Sign in" hideNav={true}>
  <article class="admin-login-card">
    <div class="admin-login-card__brand">
      <span class="admin-login-card__logo" aria-hidden="true">D</span>
      <h1 class="admin-login-card__title">Admin sign in</h1>
      <p class="admin-login-card__subtitle">
        Manage portfolio projects and content blocks.
      </p>
    </div>

    <form id="login-form" class="admin-form">
      <div class="admin-form__field">
        <label for="username" class="admin-form__label">Username</label>
        <input
          id="username"
          type="text"
          name="username"
          class="admin-input"
          placeholder="admin"
          autocomplete="username"
          required
        />
      </div>

      <div class="admin-form__field">
        <label for="password" class="admin-form__label">Password</label>
        <input
          id="password"
          type="password"
          name="password"
          class="admin-input"
          placeholder="••••••••"
          autocomplete="current-password"
          required
        />
      </div>

      <label class="admin-form__checkbox-row">
        <input id="remember-username" type="checkbox" />
        <span class="admin-form__label">Remember username</span>
      </label>

      <p id="login-error" class="admin-login-card__error" role="alert"></p>

      <button type="submit" class="admin-btn admin-btn--primary" style="width: 100%;">
        Sign in
      </button>
    </form>

    <p class="admin-form__hint" style="margin-top: 16px; text-align: center;">
      Credentials from <code>ADMIN_USER</code> / <code>ADMIN_PASS</code> on the server.
    </p>
  </article>

  <script>
    const form = document.getElementById("login-form");
    const usernameInput = document.getElementById("username");
    const passwordInput = document.getElementById("password");
    const rememberCheckbox = document.getElementById("remember-username");
    const errorEl = document.getElementById("login-error");

    try {
      const saved = JSON.parse(localStorage.getItem("admin-login") || "null");
      if (saved?.username) {
        usernameInput.value = saved.username;
        rememberCheckbox.checked = true;
      }
    } catch (e) {
      console.warn("Failed to parse admin-login from localStorage", e);
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      errorEl.textContent = "";

      const username = usernameInput.value.trim();
      const password = passwordInput.value;

      try {
        const res = await fetch("/api/admin-login", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "same-origin",
          body: JSON.stringify({ username, password }),
        });

        if (!res.ok) {
          errorEl.textContent = "Invalid credentials. Please try again.";
          return;
        }

        if (rememberCheckbox.checked) {
          localStorage.setItem("admin-login", JSON.stringify({ username }));
        } else {
          localStorage.removeItem("admin-login");
        }

        window.location.href = "/admin/dashboard";
      } catch (err) {
        console.error(err);
        errorEl.textContent = "Something went wrong. Please try again.";
      }
    });
  </script>
</AdminLayout>
