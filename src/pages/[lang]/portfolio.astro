---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import SelectedProjects from '@/components/SelectedProjects.astro';
import { getTranslations } from '@/utils/getTranslations';

const lang = Astro.params?.lang || 'en';
const translations = await getTranslations(lang);

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'uk' } },
  ];
}
---

<Layout
  translations={translations}
  lang={lang}
  seo={{ title: translations.navigation.portfolio }}
>
  <h1 class="sr-only">{translations.navigation.portfolio}</h1>
  <SelectedProjects translations={translations} lang={lang} loadMore={false} />
</Layout>
