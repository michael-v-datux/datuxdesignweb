---
// Resolve the saved language immediately; the site content has no loading dependency here.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>datux.design</title>
    <script is:inline>
      let language = 'en';
      try {
        const saved = localStorage.getItem('preferredLanguage');
        if (saved === 'uk' || saved === 'en') language = saved;
      } catch { /* The default works when browser storage is unavailable. */ }
      window.location.replace('/' + language + '/' + window.location.search + window.location.hash);
    </script>
    <noscript><meta http-equiv="refresh" content="0;url=/en/" /></noscript>
  </head>
  <body><a href="/en/">Continue to datux.design</a></body>
</html>
