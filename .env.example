# Public (browser + SSR)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
PUBLIC_SITE_URL=https://datux.design

# Server only — required for admin + RLS (never commit real values, never expose to browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

ADMIN_USER=admin
ADMIN_PASS=change-me
# Signs admin session cookie (set a long random string in production)
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

GA_ID=
